# Banco de dados (Railway/Render Postgres, ou local para desenvolvimento)
DATABASE_URL="postgresql://user:password@localhost:5432/acerto_compras"

# NextAuth
NEXTAUTH_SECRET="gerar-com: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Google OAuth (SSO restrito a @acerto.com.br) — criar em console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Conta de serviço do Workspace para envio de e-mail via Gmail API
# (domain-wide delegation, subject = compras@acerto.com.br)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Slack (Bot Token com escopo chat:write e users:read.email)
SLACK_BOT_TOKEN=""

# Segredo simples para autenticar chamadas ao cron de alertas de contrato
CRON_SECRET="gerar-string-aleatoria"

# Segredo para autenticar o futuro ERP na API de integração (ver src/app/api/erp)
ERP_API_KEY="gerar-string-aleatoria"
