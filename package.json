{
  "name": "acerto-compras",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "preinstall": "node scripts/openssl-no-alpine.cjs",
    "postinstall": "prisma generate && node scripts/verify-prisma-engine.cjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "tsx scripts/prisma-guardado.ts migrate dev",
    "prisma:push": "tsx scripts/prisma-guardado.ts db push",
    "prisma:reset": "tsx scripts/prisma-guardado.ts migrate reset",
    "prisma:studio": "tsx scripts/prisma-guardado.ts studio",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "migrations:sync": "tsx scripts/sync-migration-sql.ts",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "@aws-sdk/client-s3": "^3.700.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.20.0",
    "@react-pdf/renderer": "^4.5.1",
    "@slack/web-api": "^7.5.0",
    "googleapis": "^144.0.0",
    "lucide-react": "^1.31.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
